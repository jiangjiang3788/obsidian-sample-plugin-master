{
  "name": "think-os",
  "version": "1.0.59",
  "scripts": {
    "dev": "vite",
    "check": "npm run lint && npm run typecheck && npm run gate",
    "gate": "npm run gate:product && npm run gate:architecture && npm run gate:records && npm run gate:task-session && npm run gate:energy && npm run gate:ui-runtime && npm run gate:quality && npm run gate:stability",
    "build": "vite build && node scripts/build/fix-sourcemap.mjs && node -e \"const fs=require('fs');fs.copyFileSync('dist/main.js','main.js');fs.copyFileSync('dist/main.js.map','main.js.map');fs.copyFileSync('dist/styles.css','styles.css');\"",
    "test": "jest --config test/configs/jest.config.js",
    "test:watch": "jest --config test/configs/jest.config.js --watch",
    "test:coverage": "jest --config test/configs/jest.config.js --coverage",
    "test:unit": "jest --config test/configs/jest.config.js test/unit",
    "test:integration": "jest --config test/configs/jest.config.js test/integration",
    "test:e2e": "wdio run ./test/configs/wdio.conf.mts",
    "test:all": "npm run test && npm run test:e2e",
    "check:boundaries": "npx ts-node --project scripts/tsconfig.json scripts/audit/check-boundaries.ts",
    "refactor:metrics": "node scripts/audit/refactor-metrics.mjs --output reports/refactor/refactor-metrics.json --markdown reports/refactor/refactor-metrics.md",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "npm run typecheck:src && npm run typecheck:test && npm run typecheck:e2e",
    "knip": "npx --yes knip",
    "jscpd": "npx --yes jscpd",
    "arch:audit": "node scripts/audit/arch-audit.mjs",
    "audit:shared-ui": "node scripts/audit/audit-shared-ui-imports.mjs",
    "ci": "npm run verify:ci",
    "selectors:coverage": "node scripts/audit/selectors-coverage-report.mjs",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "build:debug": "vite build --mode development && node scripts/build/fix-sourcemap.mjs && node -e \"const fs=require('fs');fs.copyFileSync('dist/main.js','main.js');fs.copyFileSync('dist/main.js.map','main.js.map');fs.copyFileSync('dist/styles.css','styles.css');\"",
    "verify:fast": "node scripts/maintenance/verify.mjs --fast",
    "verify": "node scripts/maintenance/verify.mjs",
    "verify:ci": "node scripts/maintenance/verify.mjs --ci",
    "acceptance:fields": "node scripts/validation/field-system-acceptance.mjs",
    "acceptance:fields:strict": "node scripts/validation/field-system-acceptance.mjs --strict",
    "verify:field-system": "npm run acceptance:fields && npm run test:unit -- --runTestsByPath test/unit/templateCoreFields.test.ts test/unit/fieldValueCodec.test.ts test/unit/recordNormalizer.test.ts",
    "package:release": "node scripts/build/package-release.mjs",
    "release:check": "node scripts/gates/checks/version-sync-gate.mjs && node scripts/gates/checks/release-boundary-gate.mjs && node scripts/gates/checks/bundle-budget-gate.mjs && npm run bundle:report",
    "build:release": "vite build --mode release && node scripts/build/fix-sourcemap.mjs && node -e \"const fs=require('fs');fs.copyFileSync('dist/main.js','main.js');fs.copyFileSync('dist/styles.css','styles.css');\" && npm run package:release && npm run release:check",
    "bundle:report": "node scripts/audit/bundle-size-report.mjs",
    "css:audit": "node scripts/audit/css-audit.mjs --output reports/css/css-audit-current.json",
    "css:audit:baseline": "node scripts/gates/checks/css-boundary-gate.mjs --write-baseline",
    "css:verify": "npm run css:audit && node scripts/gates/checks/css-boundary-gate.mjs && npm run test:unit -- --runTestsByPath test/unit/cssV3Governance.test.ts test/unit/cssV4BusinessViews.test.ts test/unit/cssV5Finalization.test.ts",
    "refactor:hotspots": "node scripts/audit/refactor-hotspots.mjs --output reports/refactor/refactor-hotspots.json --markdown reports/refactor/refactor-hotspots.md",
    "refactor:verify": "npm run refactor:metrics && npm run refactor:hotspots && npm run gate:architecture && npm run gate:quality && npm run gate:records",
    "gate:product": "node scripts/gates/product-gate.mjs",
    "gate:architecture": "node scripts/gates/architecture-gate.mjs",
    "gate:records": "node scripts/gates/records-gate.mjs",
    "gate:task-session": "node scripts/gates/task-session-gate.mjs",
    "gate:energy": "node scripts/gates/energy-gate.mjs",
    "gate:ui-runtime": "node scripts/gates/ui-runtime-gate.mjs",
    "gate:quality": "node scripts/gates/quality-gate.mjs",
    "gate:stability": "node scripts/gates/stability-gate.mjs",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mui/material": "^7.2.0",
    "dayjs": "^1.11.13",
    "immer": "^10.1.1",
    "minisearch": "^7.2.0",
    "preact": "^10.26.9",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@preact/preset-vite": "^2.10.2",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@wdio/cli": "^9.19.2",
    "@wdio/globals": "^9.17.0",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/mocha-framework": "^9.19.2",
    "@wdio/spec-reporter": "^9.19.2",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^20.0.3",
    "mocha": "^10.8.2",
    "obsidian": "^1.8.7",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vite-tsconfig-paths": "^5.1.4",
    "wdio-obsidian-reporter": "^2.1.2",
    "wdio-obsidian-service": "^2.1.2"
  }
}
