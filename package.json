{
  "name": "think-os",
  "version": "1.18.4",
  "private": true,
  "scripts": {
    "help": "node -e \"process.stdout.write(require('node:fs').readFileSync('docs/HELP_AND_COMMANDS.zh-CN.md','utf8'))\"",
    "test:help": "node -e \"process.stdout.write(require('node:fs').readFileSync('docs/testing/TEST_COMMANDS_SIMPLE.zh-CN.md','utf8'))\"",
    "build": "vite build --config config/vite.config.ts --mode release",
    "build:debug": "vite build --config config/vite.config.ts --mode development && node scripts/build/fix-sourcemap.mjs",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --config config/eslint.cjs --ignore-path config/eslintignore",
    "typecheck": "tsc -p config/tsconfig.json --noEmit && tsc -p config/tsconfig.test.json --noEmit && tsc -p config/tsconfig.e2e.json --noEmit",
    "pretest": "node ./scripts/testing/check-test-ready-zh.mjs && node ./scripts/testing/selftest-runner.mjs",
    "test": "node ./scripts/testing/run-jest-with-timeout.mjs",
    "test:fast": "node ./scripts/testing/run-jest-with-timeout.mjs --fast",
    "test:watch": "node ./node_modules/jest/bin/jest.js --config ./test/configs/jest.core.config.js --watch --runInBand",
    "test:unit": "node ./node_modules/jest/bin/jest.js --config ./test/configs/jest.unit.config.js --runInBand",
    "test:integration": "node ./node_modules/jest/bin/jest.js --config ./test/configs/jest.integration.config.js --runInBand",
    "test:coverage": "node ./node_modules/jest/bin/jest.js --config ./test/configs/jest.coverage.config.js --coverage --runInBand && node ./scripts/testing/coverage-summary-zh.mjs",
    "test:performance": "node ./node_modules/jest/bin/jest.js --config ./test/configs/jest.performance.config.js --runInBand && node ./scripts/testing/performance-history.mjs",
    "test:whiteboard": "node ./node_modules/jest/bin/jest.js --config ./test/configs/jest.core.config.js --runInBand --testPathPattern=whiteboard",
    "test:smoke": "node scripts/testing/run-e2e-with-build-zh.mjs smoke",
    "test:e2e": "npm run build:debug && node scripts/testing/run-e2e-suite.mjs p0 && node scripts/testing/run-e2e-suite.mjs p1 && node scripts/testing/run-e2e-suite.mjs p2 && node scripts/testing/run-e2e-suite.mjs scale",
    "test:system": "node scripts/testing/audit-test-language.mjs && node scripts/testing/audit-test-evidence.mjs && node scripts/testing/audit-product-surface.mjs && node scripts/testing/test-system-report.mjs",
    "test:fault": "node scripts/testing/audit-fault-lab.mjs && node scripts/testing/run-fault-lab-zh.mjs && node scripts/testing/generate-fault-lab-report.mjs",
    "check:contracts": "node scripts/gates/product-gate.mjs && node scripts/gates/architecture-gate.mjs && node scripts/gates/records-gate.mjs && node scripts/gates/task-session-gate.mjs && node scripts/gates/energy-gate.mjs && node scripts/gates/ui-runtime-gate.mjs && node scripts/gates/quality-gate.mjs && node scripts/gates/stability-gate.mjs",
    "check": "npm run lint -- --quiet && npm run typecheck && npm test",
    "ci": "npm run check && npm run check:contracts && npm run build && node scripts/gates/checks/bundle-budget-gate.mjs",
    "publish:vika:check": "node scripts/build/publish-vika.mjs --diagnose",
    "publish:vika": "node scripts/build/check-vika-build.mjs && node scripts/build/publish-vika.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mui/material": "^7.2.0",
    "dayjs": "^1.11.13",
    "immer": "^10.1.1",
    "preact": "^10.26.9",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@wdio/cli": "^9.19.2",
    "@wdio/globals": "^9.17.0",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/mocha-framework": "^9.19.2",
    "@wdio/spec-reporter": "^9.19.2",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^20.0.3",
    "mocha": "^10.8.2",
    "obsidian": "^1.8.7",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vite-tsconfig-paths": "^5.1.4",
    "wdio-obsidian-reporter": "^2.1.2",
    "wdio-obsidian-service": "^2.1.2",
    "@prefresh/vite": "^2.4.12"
  }
}
