{
  "name": "think-os",
  "version": "1.0.10",
  "scripts": {
    "dev": "vite",
    "check": "npm run lint && npm run typecheck && npm run gate",
    "gate": "npm run secret:gate && npm run version:gate && npm run manifest:gate && npm run mvp:gate && npm run no-mui-icons:gate && npm run arch:public && npm run arch:capabilities && npm run arch:gate && npm run feature:gate && npm run di:gate && npm run dual-system:gate && npm run single-user:gate && npm run obsidian-leak:gate && npm run events-boundary:gate && npm run core-obsidian:gate && npm run core-public:gate && npm run shared-public:gate && npm run shared-runtime:gate && npm run gate:settings-persistence && npm run di-resolve:gate && npm run modal-promise:gate && npm run selector-giant-subscription:gate && npm run theme-tree-recursion:gate && npm run theme-matrix-legacy-import:gate && npm run iconaction:gate && npm run data-store:gate && npm run src-console:gate && npm run shared-view-export:gate && npm run performance:gate && npm run shared-view-legacy-forwarder:gate && npm run shared-internal-alias:gate && npm run timer-view-runtime:gate && npm run shared-self-alias-migrated:gate && npm run mui-compat-migrated:gate && npm run legacy-forwarder-usage:gate && npm run unused-export-candidates:gate && npm run domain:gate",
    "build": "vite build && node scripts/build/fix-sourcemap.mjs && node -e \"const fs=require('fs');fs.copyFileSync('dist/main.js','main.js');fs.copyFileSync('dist/main.js.map','main.js.map');fs.copyFileSync('dist/styles.css','styles.css');\"",
    "test": "jest --config test/configs/jest.config.js",
    "test:watch": "jest --config test/configs/jest.config.js --watch",
    "test:coverage": "jest --config test/configs/jest.config.js --coverage",
    "test:unit": "jest --config test/configs/jest.config.js test/unit",
    "test:integration": "jest --config test/configs/jest.config.js test/integration",
    "test:e2e": "wdio run ./test/configs/wdio.conf.mts",
    "test:all": "npm run test && npm run test:e2e",
    "check:boundaries": "npx ts-node --project scripts/tsconfig.json scripts/audit/check-boundaries.ts",
    "arch:gate": "node scripts/gates/arch-gate.mjs",
    "feature:gate": "node scripts/gates/feature-gate.mjs",
    "di:gate": "node scripts/gates/di-gate.mjs",
    "dual-system:gate": "node scripts/gates/dual-system-gate.mjs",
    "core-obsidian:gate": "node scripts/gates/core-obsidian-gate.mjs",
    "core-public:gate": "node scripts/gates/core-public-gate.mjs",
    "refactor:metrics": "node scripts/audit/refactor-metrics.mjs",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "public-api:gate": "npm run arch:public",
    "capability:gate": "npm run arch:capabilities",
    "knip": "npx --yes knip",
    "jscpd": "npx --yes jscpd",
    "arch:public": "node scripts/gates/public-api-gate.mjs",
    "arch:capabilities": "node scripts/gates/capability-gate.mjs",
    "shared-public:gate": "node scripts/gates/shared-public-gate.mjs",
    "arch:audit": "node scripts/audit/arch-audit.mjs",
    "audit:shared-ui": "node scripts/audit/audit-shared-ui-imports.mjs",
    "gate:settings-persistence": "node scripts/gates/settings-persistence-gate.mjs",
    "ci": "npm run verify:ci",
    "obsidian-leak:gate": "node scripts/gates/obsidian-leak-gate.mjs",
    "events-boundary:gate": "node scripts/gates/events-boundary-gate.mjs",
    "di-resolve:gate": "node scripts/gates/di-resolve-gate.mjs",
    "modal-promise:gate": "node scripts/gates/modal-promise-gate.mjs",
    "selector-giant-subscription:gate": "node scripts/gates/selector-giant-subscription-gate.mjs",
    "selectors:coverage": "node scripts/audit/selectors-coverage-report.mjs",
    "theme-tree-recursion:gate": "node scripts/gates/theme-tree-recursion-gate.mjs",
    "theme-matrix-legacy-import:gate": "node scripts/gates/theme-matrix-legacy-import-gate.mjs",
    "iconaction:gate": "node scripts/gates/iconaction-gate.mjs",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "build:debug": "vite build --mode development && node scripts/build/fix-sourcemap.mjs && node -e \"const fs=require('fs');fs.copyFileSync('dist/main.js','main.js');fs.copyFileSync('dist/main.js.map','main.js.map');fs.copyFileSync('dist/styles.css','styles.css');\"",
    "docs:index": "node scripts/docs/generate-doc-index.mjs",
    "docs:check": "npm run docs:index && git diff --exit-code -- \"文档/_资源/搜索索引.js\" \"文档/_资源/页面内容索引.js\"",
    "verify:fast": "node scripts/maintenance/verify.mjs --fast",
    "verify": "node scripts/maintenance/verify.mjs",
    "verify:ci": "node scripts/maintenance/verify.mjs --ci",
    "acceptance:fields": "node scripts/validation/field-system-acceptance.mjs",
    "acceptance:fields:strict": "node scripts/validation/field-system-acceptance.mjs --strict",
    "verify:field-system": "npm run acceptance:fields && npm run test:unit -- --runTestsByPath test/unit/fieldSystemHealth.test.ts test/unit/templateCoreFields.test.ts test/unit/fieldValueCodec.test.ts test/unit/recordNormalizer.test.ts",
    "package:release": "node scripts/build/package-release.mjs",
    "release:check": "npm run version:gate && node scripts/gates/release-boundary-gate.mjs && npm run bundle:gate && npm run bundle:report",
    "build:release": "vite build --mode release && node scripts/build/fix-sourcemap.mjs && node -e \"const fs=require('fs');fs.copyFileSync('dist/main.js','main.js');fs.copyFileSync('dist/styles.css','styles.css');\" && npm run package:release && npm run release:check",
    "secret:gate": "node scripts/gates/secret-gate.mjs",
    "version:gate": "node scripts/gates/version-sync-gate.mjs",
    "manifest:gate": "node scripts/gates/manifest-gate.mjs",
    "mvp:gate": "node scripts/gates/mvp-acceptance-gate.mjs",
    "bundle:gate": "node scripts/gates/bundle-budget-gate.mjs",
    "bundle:report": "node scripts/audit/bundle-size-report.mjs",
    "no-mui-icons:gate": "node scripts/gates/no-mui-icons-gate.mjs",
    "shared-runtime:gate": "node scripts/gates/shared-runtime-boundary-gate.mjs",
    "data-store:gate": "node scripts/gates/data-store-boundary-gate.mjs",
    "src-console:gate": "node scripts/gates/src-console-gate.mjs",
    "shared-view-export:gate": "node scripts/gates/shared-view-export-gate.mjs",
    "performance:gate": "node scripts/gates/performance-boundary-gate.mjs",
    "shared-view-legacy-forwarder:gate": "node scripts/gates/shared-view-legacy-forwarder-gate.mjs",
    "shared-internal-alias:gate": "node scripts/gates/shared-internal-alias-gate.mjs",
    "timer-view-runtime:gate": "node scripts/gates/timer-view-runtime-boundary-gate.mjs",
    "shared-self-alias-migrated:gate": "node scripts/gates/shared-self-alias-migrated-gate.mjs",
    "mui-compat-migrated:gate": "node scripts/gates/mui-compat-migrated-gate.mjs",
    "legacy-forwarder-usage:gate": "node scripts/gates/legacy-forwarder-usage-gate.mjs",
    "unused-export-candidates:gate": "node scripts/gates/unused-export-candidates-gate.mjs",
    "domain:gate": "node scripts/gates/domain-convergence-gate.mjs",
    "single-user:gate": "node scripts/gates/single-user-convergence-gate.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mui/material": "^7.2.0",
    "dayjs": "^1.11.13",
    "immer": "^10.1.1",
    "minisearch": "^7.2.0",
    "preact": "^10.26.9",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@preact/preset-vite": "^2.10.2",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@wdio/cli": "^9.19.2",
    "@wdio/globals": "^9.17.0",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/mocha-framework": "^9.19.2",
    "@wdio/spec-reporter": "^9.19.2",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^20.0.3",
    "mocha": "^10.8.2",
    "obsidian": "^1.8.7",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vite-tsconfig-paths": "^5.1.4",
    "wdio-obsidian-reporter": "^2.1.2",
    "wdio-obsidian-service": "^2.1.2"
  }
}
