{
  "schemaVersion": 1,
  "version": "v9",
  "description": "Think OS 可重复故障实验室：固定坏数据样本 + 动态故障注入 + 明确恢复预期。登记不代表执行通过。",
  "principles": [
    "故障必须可重复，不能依赖随机网络或人工时机",
    "业务源码不得知道故障实验室的存在",
    "每个场景必须声明用户影响、预期隔离行为和自动化证据",
    "发生部分提交或恢复失败时必须显式报告，不能静默吞掉"
  ],
  "scenarios": [
    {
      "id": "FL-MD-001",
      "category": "Markdown损坏",
      "name": "记录块缺少稳定记录ID",
      "risk": "P0",
      "fault": "合法包络中缺少记录ID",
      "expected": [
        "不进入有效索引",
        "产生record_id_missing完整性问题",
        "不影响同仓库其他合法记录"
      ],
      "fixtures": [
        "test/fixtures/fault-lab/markdown/缺少记录ID.md",
        "test/fixtures/fault-lab/markdown/合法思考.md"
      ],
      "evidence": [
        "test/integration/faultLabMarkdownIntegrity.test.ts"
      ],
      "covers": [
        "F011",
        "F018",
        "F019",
        "F121"
      ],
      "runGroup": "data"
    },
    {
      "id": "FL-MD-002",
